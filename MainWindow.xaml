<Window x:Class="TaskManagerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akıllı Görev Yöneticisi" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Yeni Görev Ekle" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtTitle" Width="180" Margin="5" VerticalContentAlignment="Center" Text="Görev Başlığı..."/>
                <ComboBox x:Name="CmbPriority" Width="100" Margin="5" VerticalContentAlignment="Center" SelectedIndex="1">
                    <ComboBoxItem Content="Düşük"/>
                    <ComboBoxItem Content="Orta"/>
                    <ComboBoxItem Content="Yüksek"/>
                </ComboBox>
                <DatePicker x:Name="DpDueDate" Width="120" Margin="5" VerticalContentAlignment="Center"/>
                <Button Content="Ekle" Click="BtnAdd_Click" Width="70" Margin="5" Background="#4CAF50" Foreground="White"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="DgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Başlık" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Öncelik" Binding="{Binding PriorityLevel}" Width="80"/>
                <DataGridTextColumn Header="Son Tarih" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                <DataGridCheckBoxColumn Header="Tamamlandı" Binding="{Binding IsCompleted}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Seçili Görevi Tamamla" Click="BtnComplete_Click" Width="150" Height="30" Background="#2196F3" Foreground="White"/>
            <Button Content="Seçili Görevi Sil" Click="BtnDelete_Click" Width="130" Height="30" Background="#DC143C" Foreground="White"/>
            <Button Content="Seçimi Kaldır" Click="BtnClearSelection_Click" Width="110" Height="30" Background="#87CEEB" Foreground="White"/>
        </StackPanel>
    </Grid> 
</Window>
